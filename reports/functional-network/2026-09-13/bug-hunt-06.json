    "meaning": "Debug session/trace marker to current breakpoint view and shared live-event recovery, including existing owner/Origin route boundaries.",
    "exclusions": [
      "live kernel observation or producer authentication",
      "EventBus or sampler implementation changes",
      "server authorization/storage/API wire changes",
      "cross-tab revocation and durable replay",
      "edit-aware breakpoint line relocation"
    ]
  },
  "findings": [
    {
      "id": "BH06-01",
      "status": "fixed",
      "summary": "A changed or cleared session/Engine could render previous hits and gap state before effect reset.",
      "fix": "Key observations by Engine, session and normalized declared instrumented lines; hide mismatched state immediately.",
      "regressions": [
        "a new debug session never renders the previous session's hits, even before effects",
        "clearing the debug session immediately removes old hits and gap state",
        "an Engine switch cannot render hits from a same-named session on the previous Engine"
      ]
    },
    {
      "id": "BH06-02",
      "status": "fixed",
      "summary": "Invalid and undeclared numeric lines and non-kernel live frames could reach the breakpoint view; line-set changes did not invalidate work.",
      "fix": "Require kernel breakpoint type, exact session and declared positive safe-integer line; abort obsolete subscriptions and omit empty ones.",
      "regressions": [
        "snapshot hits accept only positive integral instrumented line numbers",
        "live hits reject other categories and non-instrumented lines",
        "changing the instrumented set invalidates the old subscription and pending snapshot",
        "empty instrumented sets do not subscribe and canonical-equivalent sets do not reconnect"
      ]
    },
    {
      "id": "BH06-03",
      "status": "fixed",
      "summary": "Editor/model replacement left old decorations; stale keyboard callbacks mutated newer editors; disposal left registrations; invalid hit bounds were sent to Monaco.",
      "fix": "Capture editor/model ownership, remove original-model decoration IDs and registrations, guard late model disposal, clamp requested lines and validate hit bounds/source.",
      "regressions": [
        "replacing the editor removes decorations from the old owning model",
        "late keyboard callbacks from a replaced editor cannot toggle the current editor's breakpoints",
        "model replacement retires the previous model's decorations and clamps current breakpoints",
        "editor disposal unregisters keyboard callbacks before the controller unmounts",
        "late disposal of a previous model cannot clear the replacement model's decorations",
        "out-of-model and fractional hit lines never create editor decorations"
      ]
    },
    {
      "id": "BH06-04",
      "status": "fixed",
      "summary": "Recovery snapshot transport allowed caching/redirects; malformed frames were silently dropped without indicating possible loss.",
      "fix": "Private credentialed no-store/redirect-error snapshots; malformed frames mark a persistent gap without fabricated records or forced reconnects.",
      "regressions": [
        "event recovery snapshots are private credentialed reads that reject redirects",
        "malformed live frames leave a visible gap without manufacturing hits or reconnecting",
        "malformed live input marks a gap without retrying or discarding valid recent rows",
        "valid filtered-out frames are not misreported as data gaps"
      ]
    },
    {
      "id": "BH06-05",
      "status": "fixed",
      "summary": "Trace parsing accepted zero and numeric prefixes such as 47abc, and matched an empty debug session.",
      "fix": "Require nonempty session and a complete positive decimal token; reject zero, malformed/overflow values and leading whitespace; preserve normal suffix delimiters.",
      "regressions": [
        "rejects_zero_and_non_integral_breakpoint_markers",
        "rejects_empty_debug_session_and_whitespace_before_the_line",
        "preserves_exact_decimal_markers_with_normal_trace_suffixes"
      ]
    }
  ],
