  "findings": [
    {
      "id": "BH07-01",
      "status": "fixed",
      "summary": "A changed filter could commit old rows; invalid stored dates crashed query creation and relative windows retained expired display rows.",
      "fix": "Validate filter/date/enumeration boundaries before subscribing, key rendered history by exact view, and age relative display once per second without extra reads or acknowledgements.",
      "regressions": [
        "filter changes never commit previous-scope rows under the new selection",
        "invalid saved custom dates fail visibly instead of crashing the event page",
        "rolling time windows retire expired visible rows even without new events",
        "late snapshots and socket callbacks cannot replace a changed history filter",
        "bounded history preserves repeated events and time ticks do not query or acknowledge repeatedly"
      ]
    },
    {
      "id": "BH07-02",
      "status": "fixed",
      "summary": "Export admitted duplicate dispatch, allowed obsolete downloads after context changes and waited without a complete-body deadline.",
      "fix": "Single-flight exact filter/format ownership, abort and late-response guards, credentialed no-store/redirect-error transport, MIME/filename checks and released object URLs.",
      "regressions": [
        "export admission prevents same-turn duplicate downloads",
        "changed export filters abort the download and ignore its late response",
        "leaving the page aborts export and cannot trigger a late local download",
        "event exports reject unexpected response content instead of downloading an HTML error",
        "an export deadline covers a stalled body and returns control without a download or automatic retry",
        "returning to an earlier filter cannot resurrect an aborted export's busy state"
      ]
    },
    {
      "id": "BH07-03",
      "status": "fixed",
      "summary": "Malformed truthy deletion confirmation/counts were accepted and obsolete deletion waiting was not cancelled on departure.",
      "fix": "Accept only exact ok:true and nonnegative safe-integer deleted counts; preserve captured confirmation scope, separate authorization rejection from uncertain failure, never retry and invalidate old history/badge reads on confirmed success.",
      "regressions": [
        "unconfirmed deletion bodies cannot clear visible history or restart its stream",
        "navigation cancels deletion waiting and obsolete success cannot refresh a new view",
        "deletion has a complete waiting deadline and its failure never retries the mutation",
        "explicit deletion authorization rejection is not mislabeled as transport uncertainty",
        "confirmed deletion refreshes history and invalidates an older unread response"
      ]
    },
    {
      "id": "BH07-04",
      "status": "fixed",
      "summary": "Read acknowledgement failures were silent, pending mutations could overlap and request waiting survived departure.",
      "fix": "Filter-bound debounced single-flight acknowledgement with exact ok:true, bounded waiting and visible manual retry. Disclose the unchanged ALL-current-account event scope.",
      "regressions": [
        "failed read acknowledgements remain visible and do not silently retry on live events",
        "pending read acknowledgement is single-flight and later live arrivals request one follow-up",
        "read acknowledgement failure requires a manual retry and an explicit true response",
        "leaving before acknowledgement debounce sends no mark-read mutation",
        "leaving with a pending acknowledgement aborts it and ignores a late success",
        "changing filters cancels a pending read acknowledgement from the previous view",
        "changing filters before read debounce cannot acknowledge the obsolete snapshot"
      ]
    },
    {
      "id": "BH07-05",
      "status": "fixed",
      "summary": "Unread polls overlapped, accepted malformed counts and silently concealed failed reads.",
      "fix": "Nonoverlapping completion-based polls with a ten-second complete-body deadline, strict count parsing, an unavailable badge and current-request guards against older post-mutation reads.",
      "regressions": [
        "unread polling never overlaps a pending request and cancels it on page exit",
        "malformed unread counts show unavailable rather than a false zero or numeric badge",
        "unread timeout is visible and a later nonoverlapping poll can recover",
        "confirmed deletion refreshes history and invalidates an older unread response"
      ]
    }
  ],
