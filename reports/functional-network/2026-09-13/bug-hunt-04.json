  "findings": [
    {
      "id": "BH04-01",
      "status": "fixed",
      "summary": "Global language providers accepted foreign models; cache and requests outlived model/provider/header context; editor disposal left providers registered.",
      "fix": "Bind all six providers to their editor/current model, with per-registration exact Engine/header/model/source/cursor cache and lifecycle cleanup.",
      "regressions": [
        "completion providers never send another editor's model to their Engine",
        "model edits and replacements invalidate completion callbacks even without token cancellation",
        "completion cache cannot survive provider/header-context replacement",
        "owner disposal unregisters every language provider"
      ]
    },
    {
      "id": "BH04-02",
      "status": "fixed",
      "summary": "Shared cancellation ownership, an ignored rejecting finally promise, unbounded waits and malformed semantic items escaped the expected fallback.",
      "fix": "Independent request generations, ten-second whole-request deadline, response validation; preserve static snippets for service failure, never obsolete work.",
      "regressions": [
        "separate completion providers do not share cancellation ownership",
        "completion network failures retain snippets without unhandled promise rejections",
        "a stalled semantic JSON body has a ten-second whole-request deadline",
        "malformed semantic payloads remain snippet-only instead of escaping into providers"
      ]
    },
    {
      "id": "BH04-03",
      "status": "fixed",
      "summary": "Manual header checks allowed duplicate dispatch, stale results/errors after source changes/unmount and infrastructure failures misclassified as code issues.",
      "fix": "Input-bound state and synchronous duplicate guard, abort on context changes/unmount, existing local-only 20-second transport and separate issues/error state.",
      "regressions": [
        "manual header checks discard late results after source changes",
        "duplicate manual-check calls dispatch only once",
        "manual HTTP failures are infrastructure errors rather than compiler issues",
        "late manual-check errors cannot erase a newer successful result",
        "normal manual compiler rejection remains issues and sends only source to the local check"
      ]
    },
    {
      "id": "BH04-04",
      "status": "fixed",
      "summary": "Older metadata refreshes overwrote newer selections; failed reads silently resembled empty selection and malformed rows crashed rendering.",
      "fix": "Latest-wins ten-second credentialed metadata reads, validation and explicit loading/error; keep last successful list and invalidate all checks/providers at refresh start even for unchanged filenames.",
      "regressions": [
        "overlapping metadata refreshes cannot replace a newer header selection",
        "metadata refresh failure is visible without silently claiming an empty selection",
        "malformed metadata rows are a visible failure without crashing the editor",
        "refreshing unchanged headers invalidates pending checks and the mounted completion provider",
        "metadata deadlines end loading without losing the last selection and unmount aborts refresh",
        "header refresh errors remain visible while an explicit local self-check still works"
      ]
    },
    {
      "id": "BH04-05",
      "status": "fixed",
      "summary": "Controller wrote diagnostic markers to Monaco's first global model, not necessarily its own editor.",
      "fix": "Use the owned editor for synchronous and async diagnostic marker updates.",
      "regressions": [
        "an unrelated first Monaco model never receives this editor's diagnostic markers"
      ]
    },
    {
      "id": "BH04-06",
      "status": "fixed",
      "summary": "Three SEC snippets inserted literal backslash-n text instead of line breaks.",
      "fix": "Insert actual newlines in XDP/TC/tracepoint snippets, retaining placeholders and explicit insertion.",
      "regressions": [
        "section snippets insert actual line breaks, not literal backslash-n text",
        "real Monaco accepts semantic suggestions and multiline SEC snippets without executing code"
      ]
    }
  ],
