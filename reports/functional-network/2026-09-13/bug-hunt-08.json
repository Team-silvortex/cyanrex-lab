  "findings": [
    {
      "id": "BH08-01",
      "status": "fixed",
      "summary": "Batch/replacement INSERT generated duplicate VALUES and never persisted real rows; fallback masked the failure.",
      "fix": "QueryBuilder owns VALUES and native Json binding preserves payload types; real SQL count and nested Unicode round-trip assertions reject fallback.",
      "regressions": [
        "postgres_publish_batch_really_persists_json_without_fallback",
        "postgres_replacement_really_persists_and_marks_only_its_owner_read"
      ]
    },
    {
      "id": "BH08-02",
      "status": "fixed",
      "summary": "After insertion was repaired, pending events resurrected deleted rows/unread state and overrode a newer retention limit.",
      "fix": "Per-owner admission and an ordered writer barrier before mutations; admitted SQL work retains ownership through cache publication even after caller cancellation.",
      "regressions": [
        "postgres_mark_read_waits_for_previously_queued_events",
        "postgres_deletion_cannot_be_undone_by_its_pending_publications",
        "postgres_retention_update_cannot_be_overridden_by_queued_old_settings",
        "postgres_replacement_cannot_be_undone_by_queued_old_events",
        "postgres_cancelled_admitted_settings_finish_before_later_publications"
      ]
    },
    {
      "id": "BH08-03",
      "status": "fixed",
      "summary": "Full persistence queues spawned unbounded bypass writes.",
      "fix": "Keep the existing bounded queue and latch logged volatile fallback on full/closed queues. Bound barriers and selected schema/settings/mutation waiting stages to ten seconds; no bypass task.",
      "regressions": [
        "full_persistence_queue_latches_bounded_memory_fallback_instead_of_spawning_writers",
        "stalled_persistence_barrier_has_a_deadline_and_releases_owner_admission",
        "stalled_storage_operation_has_a_deadline_instead_of_holding_admission_forever",
        "postgres_failed_batch_releases_its_barrier_into_explicit_memory_fallback"
      ]
    },
    {
      "id": "BH08-04",
      "status": "fixed",
      "summary": "Cancelled retention/replacement split memory state, and failed SQL settings had already changed policy/cache/history.",
      "fix": "Acquire all memory locks before mutation. Settings/trim and replacement commit a SQL transaction before memory publication; replacement batches remain within SQL bind limits.",
      "regressions": [
        "cancelled_retention_update_never_splits_settings_history_and_unread",
        "cancelled_replacement_never_splits_history_and_unread",
        "cancelled_mutation_waiting_for_owner_admission_changes_nothing",
        "postgres_failed_settings_update_preserves_memory_and_previous_policy",
        "postgres_trim_failure_rolls_back_settings_and_preserves_retained_rows",
        "postgres_failed_replacement_does_not_lose_previous_durable_rows"
      ]
    },
    {
      "id": "BH08-05",
      "status": "fixed",
      "summary": "DropNew retained stale capacity after deletion; stale cold settings could overwrite newer cache; replacement accepted foreign-owner records.",
      "fix": "Invalidate capacity after deletion/settings/replacement, preserve an already newer cache entry, and reject mixed-owner replacement before changes.",
      "regressions": [
        "postgres_deletion_invalidates_drop_new_capacity_cache",
        "postgres_drop_new_can_use_capacity_freed_by_deletion_immediately",
        "postgres_cold_settings_read_cannot_overwrite_a_newer_cache_value",
        "replacement_rejects_foreign_owner_records_without_modifying_either_owner"
      ]
    },
    {
      "id": "BH08-06",
      "status": "fixed",
      "summary": "Equal-time batch sorting by event type made retention discard later publications.",
      "fix": "Stable timestamp sort and timestamp/id SQL page ordering preserve equal-time publication order.",
      "regressions": [
        "postgres_equal_timestamp_retention_does_not_sort_by_event_type",
        "postgres_equal_timestamp_latest_page_uses_publication_order"
      ],
      "note": "The latest-page case already passed under the observed original PostgreSQL plan; explicit ID tie-breaking removes reliance on that plan."
    }
  ],
