    "meaning": "Browser manual run to result display and owner inventory/detach, confirmation lifecycle and existing mock-driver ownership/deadline boundary.",
    "exclusions": [
      "live kernel attach verification or rollback",
      "server API/authentication/Runner implementation changes",
      "cross-tab idempotency or session revocation",
      "saved-script/template/learning read lifecycle"
    ]
  },
  "findings": [
    {
      "id": "BH05-01",
      "status": "fixed",
      "summary": "Duplicate run/detach dispatch, overlapping mutation types and waiting that outlived navigation/unmount.",
      "fix": "Synchronous controller-local shared gate, confirmation cancellation linkage, lifecycle ownership and complete-request timeout.",
      "regressions": [
        "run admission closes the same-turn duplicate dispatch gap",
        "pre-cancelled confirmations never dispatch a kernel run",
        "detach admission prevents duplicate mutations and simultaneous runs",
        "unmount cancels a run and late completion starts no follow-up reads"
      ]
    },
    {
      "id": "BH05-02",
      "status": "fixed",
      "summary": "Late and completed results remained attached to another draft/lab; supplementary reads prolonged the running lock.",
      "fix": "Draft/navigation epochs isolate result/error publication, stale output is hidden with an explicit no-auto-cleanup notice; refresh runs independently.",
      "regressions": [
        "late run results cannot populate another lab after navigation",
        "editing a completed run's source hides its old result and explains retained kernel state",
        "slow attachment refresh cannot keep a completed run stuck in running state",
        "a cancelled old run cannot clear the new run's busy flag or replace its error"
      ]
    },
    {
      "id": "BH05-03",
      "status": "fixed",
      "summary": "Run transport errors were swallowed before confirmation failure, and unvalidated runtime/debug responses reached consumers.",
      "fix": "Typed HTTP errors and response validation; propagate uncertainty without retry while preserving ordinary compile/validation reports and definite request/authorization rejection.",
      "regressions": [
        "run transport failure is unconfirmed and reaches the confirmation failure path without retry",
        "malformed successful run bodies cannot be published as runtime results",
        "structured validation rejection remains a normal run report",
        "explicit authentication rejection is not mislabeled as an uncertain kernel mutation"
      ]
    },
    {
      "id": "BH05-04",
      "status": "fixed",
      "summary": "Old inventory responses resurrected pins; failed reads silently looked ready/empty and malformed rows crashed rendering.",
      "fix": "Latest-wins abortable 20-second reads, row validation, retained last list with explicit loading/stale/error state and guarded cleanup controls.",
      "regressions": [
        "an old startup inventory cannot resurrect a pin after post-run refresh",
        "failed inventory refresh keeps the last list but cannot claim ready or empty success",
        "malformed attachment rows cannot crash the controller",
        "failed inventory is not empty success and must be refreshed before cleanup controls enable"
      ]
    },
    {
      "id": "BH05-05",
      "status": "fixed",
      "summary": "Missing clean was inferred true; clean false with empty notes did not fail; old result pins remained actionable after cleanup.",
      "fix": "Require explicit ok and clean true; unconfirmed cleanup fails the dialog, verified retirement clears matching pin/debug state.",
      "regressions": [
        "missing clean confirmation or unclean empty notes must not be successful cleanup",
        "verified detach retires the old result pin instead of leaving its quick action live",
        "unclean and missing cleanup confirmation remain failures without an automatic retry"
      ]
    },
    {
      "id": "BH05-06",
      "status": "fixed",
      "summary": "Character count accepted source exceeding the byte limit for UTF-8.",
      "fix": "Encode and check byte length before dispatch; reject blank source locally.",
      "regressions": [
        "UTF-8 oversized source never crosses the run boundary"
      ]
    }
  ],
