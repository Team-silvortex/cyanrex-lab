    "test:runtime-safety-browser": "node --test tests/runtimeSafety.browser.mjs",
    "test:breakpoint-lifecycle-browser": "node --test tests/breakpointLifecycle.browser.mjs",
    "test:breakpoint-safety-browser": "node --test tests/breakpointSafety.browser.mjs",
