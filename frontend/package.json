    "test:settings": "node --experimental-strip-types --test tests/settingsRequest.test.mjs",
    "test:settings-browser": "node --test tests/settingsPage.browser.mjs",
    "test:runner-inventory": "node --experimental-strip-types --test tests/runnerInventory.test.mjs",
    "test:runner-admin-browser": "node --test tests/runnerAdmin.browser.mjs",
    "test:event-page-browser": "node --test tests/eventPage.browser.mjs",
    "test:event-actions-browser": "node --test tests/eventActions.browser.mjs",
    "test:compiler-check": "node --experimental-strip-types --test tests/compilerCheck.test.mjs",
