    "test:compiler-diagnostics-browser": "node --test tests/compilerDiagnostics.browser.mjs",
    "test:event-stream-browser": "node --test tests/eventStream.browser.mjs",
    "test:security-headers": "node --test tests/securityHeaders.test.mjs",
    "test:tooling": "node --test tests/cleanMacosMetadata.test.mjs",
    "test:ui-permissions": "node --experimental-strip-types --test tests/sidebarPermissions.test.mjs tests/teachingReview.test.mjs tests/terminalCommand.test.mjs tests/learningResume.test.mjs tests/actionSafety.test.mjs tests/classroomConnection.test.mjs tests/authSession.test.mjs",
