{
  "name": "@cyanrex/frontend",
  "version": "0.3.1",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/sync-monaco-assets.mjs",
    "predev": "node ../scripts/clean-macos-metadata.mjs",
    "prebuild": "node ../scripts/clean-macos-metadata.mjs && node scripts/sync-course-docs.mjs",
    "sync:course": "node scripts/sync-course-docs.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test:performance-hotspots": "node --experimental-strip-types --test tests/performanceHotspots.test.mjs",
    "test:security-headers": "node --test tests/securityHeaders.test.mjs",
    "test:tooling": "node --test tests/cleanMacosMetadata.test.mjs",
    "test:ui-permissions": "node --experimental-strip-types --test tests/sidebarPermissions.test.mjs tests/teachingReview.test.mjs tests/terminalCommand.test.mjs",
    "lint": "next lint"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "next": "^15.5.22",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.15.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.0.10",
    "@types/react-dom": "19.0.4",
    "typescript": "5.8.3"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "nanoid": "^3.3.18",
    "postcss": "^8.5.20",
    "sharp": "^0.35.0"
  }
}
