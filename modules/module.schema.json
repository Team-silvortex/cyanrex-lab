{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cyanrex.dev/schemas/module-manifest-v1.json",
  "title": "Cyanrex Module Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "name", "version", "description", "capabilities"],
  "properties": {
    "$schema": {
      "const": "../module.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
    },
    "version": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)([-+][0-9A-Za-z.+-]+)?$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9])?$"
      }
    }
  }
}
