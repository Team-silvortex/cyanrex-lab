# Performance regression thresholds for event-bus benchmark.
# Source before running perf-regression-check.sh:
#   set -a; source scripts/perf-baseline/perf-thresholds.env; set +a

# Optional: path to baseline JSON (single-line output).
CYANREX_BENCH_BASELINE_JSON="${CYANREX_BENCH_BASELINE_JSON:-scripts/perf-baseline/event-bus-baseline.json}"

# Baseline/current labels for clear output.
CYANREX_BENCH_BASELINE_LABEL="${CYANREX_BENCH_BASELINE_LABEL:-baseline}"
CYANREX_BENCH_REGRESSION_LABEL="${CYANREX_BENCH_REGRESSION_LABEL:-current}"

# Regression thresholds
CYANREX_BENCH_MIN_THROUGHPUT_DELTA_PCT="${CYANREX_BENCH_MIN_THROUGHPUT_DELTA_PCT:--5}"
CYANREX_BENCH_MAX_P50_INCREASE_PCT="${CYANREX_BENCH_MAX_P50_INCREASE_PCT:-15}"
CYANREX_BENCH_MAX_P95_INCREASE_PCT="${CYANREX_BENCH_MAX_P95_INCREASE_PCT:-20}"
CYANREX_BENCH_MAX_P99_INCREASE_PCT="${CYANREX_BENCH_MAX_P99_INCREASE_PCT:-30}"
