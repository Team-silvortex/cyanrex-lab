# Copy to docker/.env or run ../start.sh once to generate random secrets.
POSTGRES_PASSWORD=replace-with-a-long-random-password
CYANREX_ADMIN_PASSWORD=replace-with-a-long-random-password
CYANREX_ADMIN_TOTP_SECRET=REPLACEWITHBASE32SECRET

# Keep loopback-only unless a trusted reverse proxy/firewall protects the service.
CYANREX_BIND_ADDRESS=127.0.0.1
CYANREX_ALLOW_REGISTRATION=false
CYANREX_ALLOW_TOTP_BOOTSTRAP=false
CYANREX_SECURE_COOKIES=false
# Allow state-changing API requests without Origin/Referer header.
# Useful for trusted offline/local script clients; keep disabled in browser-accessed deployments.
CYANREX_ALLOW_MISSING_ORIGIN=false
CYANREX_INSTANCE_ID=default
# Local-process Runner capacity. This limits work but does not isolate the shared kernel.
CYANREX_RUNNER_MODE=local_process
CYANREX_RUNNER_MAX_CONCURRENT=2
CYANREX_RUNNER_MAX_PER_USER=1
# Hard limit for one synchronous compile/load execution (5-300 seconds).
CYANREX_RUNNER_TIMEOUT_SECS=45
# Optional Runner Agent control plane; empty means disabled. Generate at least 32 random characters.
CYANREX_RUNNER_AGENT_TOKEN=
# Agent becomes offline after this many seconds; its in-memory record is later removed.
CYANREX_RUNNER_AGENT_TTL_SECS=30
CYANREX_RUNNER_AGENT_RETENTION_SECS=300
# Accepted clock skew/freshness window for signed Agent requests (15-300 seconds).
CYANREX_RUNNER_AGENT_SIGNATURE_WINDOW_SECS=60
# Optional custom PostgreSQL volume name for multi-instance deployments.
# Keep unique per instance id to avoid data clashes.
CYANREX_POSTGRES_VOLUME_NAME=cyanrex-postgres-data-${CYANREX_INSTANCE_ID:-default}
# One-shot migration switch for an existing database; turn it off after one successful start.
CYANREX_ROTATE_ADMIN_CREDENTIALS=false

# Persist queue pressure alert switch for engine event persistence.
CYANREX_EVENT_PERSIST_QUEUE_WARNING_ENABLED=true
# Emit warning when queued persist requests reach this percentage of the 2048 cap (1-100).
CYANREX_EVENT_PERSIST_QUEUE_WARNING_RATIO_PCT=80
# Clear queue-pressure status when queued persist requests drop below this percentage (<= warning ratio).
CYANREX_EVENT_PERSIST_QUEUE_CLEAR_RATIO_PCT=40
# Minimum interval between queue-pressure warning logs in milliseconds.
CYANREX_EVENT_PERSIST_QUEUE_WARNING_INTERVAL_MS=10000
