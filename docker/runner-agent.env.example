# Copy to a private file on the Agent node and keep permissions at 0600.
CYANREX_AGENT_ENGINE_URL=https://cyanrex-engine.example.internal
CYANREX_AGENT_BOOTSTRAP_TOKEN_FILE=/run/secrets/cyanrex-agent-bootstrap-token
CYANREX_AGENT_ID=lab-vm-01
# Choose the truthful boundary: shared_kernel, container, virtual_machine, or dedicated_host.
CYANREX_AGENT_ISOLATION=virtual_machine
CYANREX_AGENT_MAX_CONCURRENT=1
CYANREX_AGENT_CAPABILITIES=control_probe
# Compile-only jobs are opt-in and forbidden with shared_kernel isolation.
CYANREX_AGENT_ENABLE_COMPILE_CHECK=false
CYANREX_AGENT_CLANG_PATH=/usr/bin/clang
CYANREX_AGENT_COMPILE_WORK_DIR=/tmp/cyanrex-runner-agent
CYANREX_AGENT_POLL_SECS=5
CYANREX_AGENT_REQUEST_TIMEOUT_SECS=10
# Required only for explicitly trusted non-loopback HTTP lab networks. Prefer HTTPS.
CYANREX_AGENT_ALLOW_INSECURE_HTTP=false
