ENGINE_HOST=0.0.0.0
ENGINE_PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cyanrex
# Optional Runner Agent control plane. Keep empty to disable; configured tokens require 32+ characters.
CYANREX_RUNNER_AGENT_TOKEN=
CYANREX_RUNNER_AGENT_TTL_SECS=30
CYANREX_RUNNER_AGENT_RETENTION_SECS=300
CYANREX_RUNNER_AGENT_SIGNATURE_WINDOW_SECS=60
